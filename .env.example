# Target Model to run in Ollama (e.g. llama3.1:8b, qwen2.5:14b, qwen2.5:32b)
MODEL=llama3.1:8b

# Bearer API Key required for client authentication (MUST be changed)
API_KEY=change-this-to-a-secure-random-token

# TLS / Domain Configuration:
# MODE A (Domain): Set to your fully-qualified domain name (e.g., DOMAIN=llm.example.com)
# MODE B (No Domain): Leave blank or unset to generate in-container self-signed/internal TLS certificates
DOMAIN=

# ACME Email (Optional, used for Let's Encrypt renewal notices in MODE A)
ACME_EMAIL=admin@example.com

# Port Caddy listens on inside the container (default: 8443)
HTTPS_PORT=8443

# Ollama bind address (internal loopback only - DO NOT CHANGE TO 0.0.0.0)
OLLAMA_HOST=127.0.0.1:11434

# Ollama keep alive duration for loaded models in GPU VRAM
OLLAMA_KEEP_ALIVE=30m
